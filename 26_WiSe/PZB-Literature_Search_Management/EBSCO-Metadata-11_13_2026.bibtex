 citedByCount  = "null",
}

@article{2002-15399-00320020801,
 abstract  = "Examined the construction and performance of Darwin VII, a neurally organized mobile adaptive device capable of perceptual categorization and conditioned behavior. Darwin VII's perceptual performance was tested in a real environment that included obstacle avoidance, visual exploration, visual approach and tracking, gripping, simulated tasting, and appetitive and aversive behavioral reflex responses. Results show that Darwin VII demonstrated neural mechanisms for invariant object recognition, experience-dependent perceptual categorization, 1st-order and 2nd-order conditioning, and the effects of different learning rates on responses to appetitive and aversive events. Different exemplars of Darwin VII developed similar categorical responses that depended on exploration of the environment and sensorimotor adaptation, with each showing highly individual patterns of changes in synaptic strengths. It is concluded that brain-based devices provide valuable mechanisms for understanding cortica",
 author    = "Krichmar, Jeffrey L. and Edelman, Gerald M.",
 number    = "8",
 title     = "Machine psychology: Autonomous behavior, perceptual categorization and conditioning in a brain-based device.",
 volume    = "12",
 url       = "https://research.ebsco.com/plink/d8cddfbd-46c3-39f7-bd19-accfcddd43fe",
 year      = "2002",
 issn      = "1460-2199",
 journal   = "Cerebral Cortex",
 keywords  = "Classification (Cognitive Process); Conditioning; Neural Networks; Robotics; Visual Perception; Grasping; Taste Perception",
 pages     = "818-830",
 note      = "",
}

