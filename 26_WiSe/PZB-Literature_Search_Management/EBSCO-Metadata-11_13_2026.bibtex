@misc{daac19a4-112c-45fe-9d6a-d9c6f4fe3db420170101,
 abstract      = "Es wird eine kurze Einführung in die Möglichkeiten immersiver virtueller Realität (VR) in der psychologischen Forschung und Anwendung gegeben. Diese Art von VR ermöglicht es Personen, eine computergenerierte VR so zu erleben, dass sie das Gefühl haben, mit ihrem Körper in dieser Welt präsent sind. Dazu werden drei technische Komponenten kombiniert: eine dreidimensionale, via Computer generierte virtuelle Umwelt, eine Technologie zur Präsentation dieser Welt und ein Tracking-System, das aus Sensoren besteht, die die Bewegungen des Kopfes und ggf. des ganzen Körpers registrieren. Diese Kopf-/Körperbewegungsdaten werden in Echtzeit dazu benutzt, um zu bestimmen, in welche Richtung eine Person innerhalb einer virtuellen Umgebung schaut, um ihr den entsprechenden Ausschnitt dieser Umgebung präsentieren zu können. Es werden Beispiele skizziert, in denen immersive VR in der psychologischen Forschung eingesetzt wurden, etwa zur Frage der Identifikation mit Avataren, zur Untersuchung sozialer ",
 author        = "Dobricki, Martin",
 title         = "The experience machine. Psychology researchers discover the big potential of the virtual reality (ZPID) : ",
 url           = "https://research.ebsco.com/plink/d177fcad-28d4-3acf-a042-10ae2534b933",
 year          = "2017",
 keywords      = "Virtual Reality; Virtuelle Realität; Virtual Reality; Rehabilitation; Exposure Therapy; Role Taking; Emotions; Psychotherapy; Virtuelle Realität; Rehabilitation; Expositionstherapie; Rollenübernahme; Emotionen; Psychotherapie; Virtual Reality; Rehabilitation; Exposure Therapy; Role Taking; Emotions; Psychotherapy",
 note          = "",
 articleType   = "null",
 retracted     = "null",
 retractionNote = "null",
 citedByCount  = "null",
}

@misc{e1044b39-3fcc-4c94-ac7e-a2dbcd490d8720000101,
 abstract      = "Untersuchungsgegenstand ist die Entwicklung des französischen Materialismus von der Aufklärung bis zum Positivismus in zeitlicher Parallele zur Herausbildung der Psychologie als Antipodin einer materialistischen Theorie der Gesellschaft. Ausgehend von der Analyse von La Mettries Schrift "Der Mensch als Maschine" (1747/48) wird gezeigt, wie eine in der Romantik nicht weiter entwickelte materialistische Gesellschaftstheorie kompensatorisch die Ausbildung der Psychologie als humanwissenschaftliche Disziplin förderte oder begründete und wie sie dann in Umrissen erkennbar wurde im zweiten dieser Untersuchung zugrundeliegenden Text, den Essays über die zeitgenössische Psychologie (1883/85) von Paul Bourget.",
 author        = "Knapp, Lothar",
 title         = "L'homme machine: Psychology (ZPID) : ",
 url           = "https://research.ebsco.com/plink/e52ddd49-3128-3b3b-b83b-4049b4c340fc",
 year          = "2000",
 keywords      = "History of Psychology; Materialism; Geschichte der Psychologie; Materialismus (Werthaltung); History of Psychology; Materialism; Theories; Geschichte der Psychologie; Materialismus (Werthaltung); Theorien; History of Psychology; Materialism; Theories",
 note          = "",
 articleType   = "null",
 retracted     = "null",
